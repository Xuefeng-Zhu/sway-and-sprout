{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "PROPOSED ONLY: opt-in Sway & Sprout garden-summary backup. No vision data. Deployment/IAM/spend requires separate approval.",
  "Parameters": {
    "FunctionName": {
      "Type": "String",
      "Default": "sway-sprout-garden-backup",
      "AllowedPattern": "[a-zA-Z0-9-_]{1,48}"
    },
    "AllowedOrigins": {
      "Type": "CommaDelimitedList",
      "Default": "http://127.0.0.1:4173",
      "Description": "Explicit approved browser origins only. No wildcard. Native TV cloud networking remains disabled."
    }
  },
  "Resources": {
    "GardenTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "gardenId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "gardenId",
            "KeyType": "HASH"
          }
        ],
        "OnDemandThroughput": {
          "MaxReadRequestUnits": 5,
          "MaxWriteRequestUnits": 5
        },
        "TimeToLiveSpecification": {
          "AttributeName": "expiresAt",
          "Enabled": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "SwayAndSprout"
          },
          {
            "Key": "Purpose",
            "Value": "ApprovedBoundedDemoOnly"
          }
        ]
      }
    },
    "FunctionLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${FunctionName}"
        },
        "RetentionInDays": 7
      }
    },
    "FunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "GardenItemOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "GardenTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "FunctionLogs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "GardenFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": [
        "FunctionLogs"
      ],
      "Properties": {
        "FunctionName": {
          "Ref": "FunctionName"
        },
        "Runtime": "python3.13",
        "Architectures": [
          "arm64"
        ],
        "Handler": "index.lambda_handler",
        "Role": {
          "Fn::GetAtt": [
            "FunctionRole",
            "Arn"
          ]
        },
        "MemorySize": 128,
        "Timeout": 3,
        "ReservedConcurrentExecutions": 2,
        "Environment": {
          "Variables": {
            "GARDEN_TABLE": {
              "Ref": "GardenTable"
            },
            "ALLOWED_ORIGINS": {
              "Fn::Join": [
                ",",
                {
                  "Ref": "AllowedOrigins"
                }
              ]
            }
          }
        }
      }
    },
    "GardenApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-garden-backup"
        },
        "ProtocolType": "HTTP",
        "CorsConfiguration": {
          "AllowOrigins": {
            "Ref": "AllowedOrigins"
          },
          "AllowMethods": [
            "GET",
            "PUT",
            "DELETE",
            "OPTIONS"
          ],
          "AllowHeaders": [
            "authorization",
            "content-type",
            "if-match"
          ],
          "MaxAge": 300
        }
      }
    },
    "GardenIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "GardenApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationMethod": "POST",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "GardenFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 4000
      }
    },
    "GardenRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "GardenApi"
        },
        "RouteKey": "ANY /gardens/{gardenId}",
        "AuthorizationType": "NONE",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "GardenIntegration"
              }
            ]
          ]
        }
      }
    },
    "GardenStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "GardenApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 2,
          "ThrottlingRateLimit": 1,
          "DetailedMetricsEnabled": false
        }
      }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "GardenFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${GardenApi}/*/*/gardens/*"
        }
      }
    }
  },
  "Outputs": {
    "ApiEndpoint": {
      "Description": "Future approved API base URL; configure browser only after actual deployment verification.",
      "Value": {
        "Fn::GetAtt": [
          "GardenApi",
          "ApiEndpoint"
        ]
      }
    }
  }
}
